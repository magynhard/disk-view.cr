#: src/window.cr:17 src/window.cr:24
msgid "Refresh"
msgstr "Aggiorna"

#: src/window.cr:22
msgid "Main menu"
msgstr "Menu principale"

#: src/window.cr:25
msgid "About Disk View"
msgstr "Informazioni su Disk View"

#: src/window.cr:26
msgid "Close"
msgstr "Chiudi"

#: src/window.cr:36
msgid "Drives & Partitions"
msgstr "Unità e partizioni"

#: src/window.cr:37
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Spazio utilizzato · aggiornamento automatico ogni 15 secondi"

#: src/window.cr:97
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Unità, partizioni e utilizzo del disco a colpo d’occhio.\n"
"Sviluppato con Crystal, GTK4 e libadwaita."

#: src/window.cr:123
msgid "Other filesystems / Network"
msgstr "Altri file system / Rete"

#: src/window.cr:131
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} unità"
msgstr[1] "%{count} unità"

#: src/window.cr:131
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Aggiornato alle %{time}"

#: src/window.cr:133
msgid "Could not read drives: %{error}"
msgstr "Impossibile leggere le unità: %{error}"

#: src/window.cr:163
msgid "Reading …"
msgstr "Lettura…"

#: src/window.cr:204 src/window.cr:238 src/window.cr:261
msgid "%{size} total"
msgstr "%{size} totali"

#: src/window.cr:205 src/window.cr:252
msgid "%{state} · Usage unknown"
msgstr "%{state} · Utilizzo sconosciuto"

#: src/window.cr:227
msgid "Usage unknown · no measurable filesystems"
msgstr "Utilizzo sconosciuto · nessun file system misurabile"

#: src/window.cr:230 src/window.cr:259
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} utilizzati (%{percent} %%)"

#: src/window.cr:232
msgid "At least %{size} used (%{percent} %%)"
msgstr "Almeno %{size} utilizzati (%{percent} %%)"

#: src/window.cr:234 src/window.cr:260
msgid "%{size} available"
msgstr "%{size} disponibili"

#: src/window.cr:235 src/window.cr:262
msgid "%{size} reserved"
msgstr "%{size} riservati"

#: src/window.cr:236
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} misurati"

#: src/window.cr:240
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"L’utilizzo è relativo alla capacità totale dell’unità. I file system non "
"montati o distribuiti su più dispositivi sono esclusi dal totale. Lo spazio "
"non partizionato non è spazio disponibile in un file system."

#: src/window.cr:263
msgid "%{size} filesystem size"
msgstr "%{size} di dimensione del file system"

#: src/window.cr:267
msgid "Usage unavailable"
msgstr "Utilizzo non disponibile"

#: src/window.cr:277
msgid "Not mounted"
msgstr "Non montato"

#: src/window.cr:279
msgid "Used by %{devices}"
msgstr "Utilizzato da %{devices}"

#: src/window.cr:281
msgid "Swap (active)"
msgstr "Swap (attivo)"

#: src/window.cr:294
msgid "The filesystem does not report disk usage."
msgstr "Il file system non riporta l’utilizzo del disco."

#: src/window.cr:307
msgid "Could not read filesystem."
msgstr "Impossibile leggere il file system."
