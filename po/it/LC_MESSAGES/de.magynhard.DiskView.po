#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Aggiorna"

#: src/window.cr:31
msgid "Main menu"
msgstr "Menu principale"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Informazioni su Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Chiudi"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Unità e partizioni"

#: src/window.cr:52
msgid "Size units"
msgstr "Unità di misura"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibyte (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabyte (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Spazio utilizzato · aggiornamento automatico ogni 15 secondi"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Unità, partizioni e utilizzo del disco a colpo d’occhio.\n"
"Sviluppato con Crystal, GTK4 e libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Altri file system / Rete"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} unità"
msgstr[1] "%{count} unità"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Aggiornato alle %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Impossibile leggere le unità: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Lettura…"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "I file system di sistema non possono essere smontati qui."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Nessun file system montabile"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Smonta tutti i file system"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Monta tutti i file system"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Smonta file system"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Monta file system"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Montaggio dei file system…"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Smontaggio dei file system…"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Operazione sui file system completata"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Operazione sui file system non riuscita"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Le seguenti operazioni non sono riuscite:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "%{size} totali"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Utilizzo sconosciuto"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Non montato · utilizzo non disponibile"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Utilizzo sconosciuto · nessun file system misurabile"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} utilizzati (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Almeno %{size} utilizzati (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} disponibili"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} riservati"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} misurati"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"L’utilizzo è relativo alla capacità totale dell’unità. I file system non "
"montati o distribuiti su più dispositivi sono esclusi dal totale. Lo spazio "
"non partizionato non è spazio disponibile in un file system."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Le partizioni riservate Microsoft non hanno un file system e sono escluse "
"dall’utilizzo totale."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Partizione riservata · nessun file system"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Monta questo file system per leggerne l’utilizzo del disco."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "%{size} di dimensione del file system"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Utilizzo non disponibile"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Non montato"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Utilizzato da %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Swap (attivo)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Cifrato (bloccato)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Riservata Microsoft (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Dati di base Microsoft"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Ripristino di Windows"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "Partizione di sistema EFI"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Il file system non riporta l’utilizzo del disco."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Impossibile leggere il file system."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 non è disponibile."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Il file system non è più disponibile."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Questo file system non può essere montato o smontato qui."
