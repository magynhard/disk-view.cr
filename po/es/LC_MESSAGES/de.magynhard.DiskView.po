#: src/window.cr:17 src/window.cr:24
msgid "Refresh"
msgstr "Actualizar"

#: src/window.cr:22
msgid "Main menu"
msgstr "Menú principal"

#: src/window.cr:25
msgid "About Disk View"
msgstr "Acerca de Disk View"

#: src/window.cr:26
msgid "Close"
msgstr "Cerrar"

#: src/window.cr:36
msgid "Drives & Partitions"
msgstr "Unidades y particiones"

#: src/window.cr:37
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Espacio utilizado · actualización automática cada 15 segundos"

#: src/window.cr:97
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Unidades, particiones y uso del disco de un vistazo.\n"
"Desarrollado con Crystal, GTK4 y libadwaita."

#: src/window.cr:123
msgid "Other filesystems / Network"
msgstr "Otros sistemas de archivos / Red"

#: src/window.cr:131
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} unidad"
msgstr[1] "%{count} unidades"

#: src/window.cr:131
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Actualizado a las %{time}"

#: src/window.cr:133
msgid "Could not read drives: %{error}"
msgstr "No se pudieron leer las unidades: %{error}"

#: src/window.cr:163
msgid "Reading …"
msgstr "Leyendo…"

#: src/window.cr:204 src/window.cr:238 src/window.cr:261
msgid "%{size} total"
msgstr "%{size} en total"

#: src/window.cr:205 src/window.cr:252
msgid "%{state} · Usage unknown"
msgstr "%{state} · Uso desconocido"

#: src/window.cr:227
msgid "Usage unknown · no measurable filesystems"
msgstr "Uso desconocido · ningún sistema de archivos medible"

#: src/window.cr:230 src/window.cr:259
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} utilizados (%{percent} %%)"

#: src/window.cr:232
msgid "At least %{size} used (%{percent} %%)"
msgstr "Al menos %{size} utilizados (%{percent} %%)"

#: src/window.cr:234 src/window.cr:260
msgid "%{size} available"
msgstr "%{size} disponibles"

#: src/window.cr:235 src/window.cr:262
msgid "%{size} reserved"
msgstr "%{size} reservados"

#: src/window.cr:236
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} medidos"

#: src/window.cr:240
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"El uso se calcula respecto a la capacidad total de la unidad. Los sistemas "
"de archivos sin montar o distribuidos entre varios dispositivos se excluyen "
"del total. El espacio sin particionar no es espacio disponible en un sistema "
"de archivos."

#: src/window.cr:263
msgid "%{size} filesystem size"
msgstr "%{size} de tamaño del sistema de archivos"

#: src/window.cr:267
msgid "Usage unavailable"
msgstr "Uso no disponible"

#: src/window.cr:277
msgid "Not mounted"
msgstr "Sin montar"

#: src/window.cr:279
msgid "Used by %{devices}"
msgstr "Utilizado por %{devices}"

#: src/window.cr:281
msgid "Swap (active)"
msgstr "Intercambio (activo)"

#: src/window.cr:294
msgid "The filesystem does not report disk usage."
msgstr "El sistema de archivos no informa del uso del disco."

#: src/window.cr:307
msgid "Could not read filesystem."
msgstr "No se pudo leer el sistema de archivos."
