#: src/window.cr:21 src/window.cr:28
msgid "Refresh"
msgstr "Actualizar"

#: src/window.cr:26
msgid "Main menu"
msgstr "Menú principal"

#: src/window.cr:29
msgid "About Disk View"
msgstr "Acerca de Disk View"

#: src/window.cr:30 src/window.cr:218
msgid "Close"
msgstr "Cerrar"

#: src/window.cr:40
msgid "Drives & Partitions"
msgstr "Unidades y particiones"

#: src/window.cr:41
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Espacio utilizado · actualización automática cada 15 segundos"

#: src/window.cr:104
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Unidades, particiones y uso del disco de un vistazo.\n"
"Desarrollado con Crystal, GTK4 y libadwaita."

#: src/window.cr:132
msgid "Other filesystems / Network"
msgstr "Otros sistemas de archivos / Red"

#: src/window.cr:140
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} unidad"
msgstr[1] "%{count} unidades"

#: src/window.cr:140
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Actualizado a las %{time}"

#: src/window.cr:142
msgid "Could not read drives: %{error}"
msgstr "No se pudieron leer las unidades: %{error}"

#: src/window.cr:172
msgid "Reading …"
msgstr "Leyendo…"

#: src/window.cr:189
msgid "System filesystems cannot be unmounted here."
msgstr "Los sistemas de archivos del sistema no se pueden desmontar aquí."

#: src/window.cr:191
msgid "No mountable filesystem"
msgstr "Ningún sistema de archivos montable"

#: src/window.cr:193
msgid "Unmount all filesystems"
msgstr "Desmontar todos los sistemas de archivos"

#: src/window.cr:193
msgid "Mount all filesystems"
msgstr "Montar todos los sistemas de archivos"

#: src/window.cr:195
msgid "Unmount filesystem"
msgstr "Desmontar sistema de archivos"

#: src/window.cr:195
msgid "Mount filesystem"
msgstr "Montar sistema de archivos"

#: src/window.cr:209
msgid "Mounting filesystems …"
msgstr "Montando sistemas de archivos…"

#: src/window.cr:209
msgid "Unmounting filesystems …"
msgstr "Desmontando sistemas de archivos…"

#: src/window.cr:215
msgid "Filesystem operation completed"
msgstr "Operación de sistemas de archivos completada"

#: src/window.cr:217
msgid "Filesystem operation failed"
msgstr "Falló la operación de sistemas de archivos"

#: src/window.cr:217
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Las siguientes operaciones fallaron:\n"
"%{errors}"

#: src/window.cr:268 src/window.cr:306 src/window.cr:341
msgid "%{size} total"
msgstr "%{size} en total"

#: src/window.cr:269 src/window.cr:330
msgid "%{state} · Usage unknown"
msgstr "%{state} · Uso desconocido"

#: src/window.cr:292
msgid "Not mounted · usage unavailable"
msgstr "Sin montar · uso no disponible"

#: src/window.cr:294
msgid "Usage unknown · no measurable filesystems"
msgstr "Uso desconocido · ningún sistema de archivos medible"

#: src/window.cr:298 src/window.cr:339
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} utilizados (%{percent} %%)"

#: src/window.cr:300
msgid "At least %{size} used (%{percent} %%)"
msgstr "Al menos %{size} utilizados (%{percent} %%)"

#: src/window.cr:302 src/window.cr:340
msgid "%{size} available"
msgstr "%{size} disponibles"

#: src/window.cr:303 src/window.cr:342
msgid "%{size} reserved"
msgstr "%{size} reservados"

#: src/window.cr:304
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} medidos"

#: src/window.cr:308
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"El uso se calcula respecto a la capacidad total de la unidad. Los sistemas "
"de archivos sin montar o distribuidos entre varios dispositivos se excluyen "
"del total. El espacio sin particionar no es espacio disponible en un sistema "
"de archivos."

#: src/window.cr:309
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Las particiones reservadas de Microsoft no tienen sistema de archivos y se "
"excluyen del uso total."

#: src/window.cr:328
msgid "Reserved partition · no filesystem"
msgstr "Partición reservada · sin sistema de archivos"

#: src/window.cr:332
msgid "Mount this filesystem to read its disk usage."
msgstr "Monte este sistema de archivos para consultar su uso del disco."

#: src/window.cr:343
msgid "%{size} filesystem size"
msgstr "%{size} de tamaño del sistema de archivos"

#: src/window.cr:347
msgid "Usage unavailable"
msgstr "Uso no disponible"

#: src/window.cr:357
msgid "Not mounted"
msgstr "Sin montar"

#: src/window.cr:359
msgid "Used by %{devices}"
msgstr "Utilizado por %{devices}"

#: src/window.cr:361
msgid "Swap (active)"
msgstr "Intercambio (activo)"

#: src/window.cr:363
msgid "Encrypted (locked)"
msgstr "Cifrado (bloqueado)"

#: src/window.cr:370
msgid "Microsoft reserved (MSR)"
msgstr "Reservada de Microsoft (MSR)"

#: src/window.cr:371
msgid "Microsoft basic data"
msgstr "Datos básicos de Microsoft"

#: src/window.cr:372
msgid "Windows recovery"
msgstr "Recuperación de Windows"

#: src/window.cr:373
msgid "EFI system partition"
msgstr "Partición del sistema EFI"

#: src/window.cr:386
msgid "The filesystem does not report disk usage."
msgstr "El sistema de archivos no informa del uso del disco."

#: src/window.cr:399
msgid "Could not read filesystem."
msgstr "No se pudo leer el sistema de archivos."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 no está disponible."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "El sistema de archivos ya no está disponible."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Este sistema de archivos no se puede montar ni desmontar aquí."
