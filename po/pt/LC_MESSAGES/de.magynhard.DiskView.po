#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Atualizar"

#: src/window.cr:31
msgid "Main menu"
msgstr "Menu principal"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Acerca do Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Fechar"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Unidades e partições"

#: src/window.cr:52
msgid "Size units"
msgstr "Unidades de tamanho"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibytes (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabytes (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Espaço utilizado · atualização automática a cada 15 segundos"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Unidades, partições e utilização do disco num relance.\n"
"Criado com Crystal, GTK4 e libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Outros sistemas de ficheiros / Rede"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} unidade"
msgstr[1] "%{count} unidades"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Atualizado às %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Não foi possível ler as unidades: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "A ler …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Os sistemas de ficheiros do sistema não podem ser desmontados aqui."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Nenhum sistema de ficheiros montável"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Desmontar todos os sistemas de ficheiros"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Montar todos os sistemas de ficheiros"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Desmontar sistema de ficheiros"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Montar sistema de ficheiros"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "A montar sistemas de ficheiros …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "A desmontar sistemas de ficheiros …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Operação do sistema de ficheiros concluída"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "A operação do sistema de ficheiros falhou"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"As seguintes operações falharam:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "%{size} no total"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Utilização desconhecida"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Não montado · utilização indisponível"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Utilização desconhecida · sem sistemas de ficheiros mensuráveis"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} utilizados (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Pelo menos %{size} utilizados (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} disponíveis"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} reservados"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} medidos"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"A utilização é relativa à capacidade total da unidade. Os sistemas de "
"ficheiros não montados ou em vários dispositivos são excluídos do total. O "
"espaço não particionado não é espaço disponível num sistema de ficheiros."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"As partições reservadas da Microsoft não têm sistema de ficheiros e são "
"excluídas dos totais de utilização."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Partição reservada · sem sistema de ficheiros"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr ""
"Monte este sistema de ficheiros para consultar a sua utilização do disco."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "%{size} de tamanho do sistema de ficheiros"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Utilização indisponível"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Não montado"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Utilizado por %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Swap (ativa)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Encriptado (bloqueado)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Reservada da Microsoft (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Dados básicos da Microsoft"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Recuperação do Windows"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "Partição de sistema EFI"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "O sistema de ficheiros não indica a utilização do disco."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Não foi possível ler o sistema de ficheiros."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "O UDisks2 não está disponível."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "O sistema de ficheiros já não está disponível."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Este sistema de ficheiros não pode ser montado ou desmontado aqui."
