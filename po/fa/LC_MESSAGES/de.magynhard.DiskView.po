#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "تازه‌سازی"

#: src/window.cr:31
msgid "Main menu"
msgstr "فهرست اصلی"

#: src/window.cr:34
msgid "About Disk View"
msgstr "دربارهٔ Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "بستن"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "دیسک‌ها و افرازها"

#: src/window.cr:52
msgid "Size units"
msgstr "واحدهای اندازه"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "گیبی‌بایت (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "گیگابایت (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "فضای استفاده‌شده · تازه‌سازی خودکار هر ۱۵ ثانیه"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"نمایی از دیسک‌ها، افرازها و میزان استفاده از دیسک.\n"
"ساخته‌شده با Crystal، GTK4 و libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "سامانه‌های پروندهٔ دیگر / شبکه"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} دیسک"
msgstr[1] "%{count} دیسک"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · به‌روز شده در %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "خواندن دیسک‌ها ممکن نشد: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "در حال خواندن …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "سامانه‌های پروندهٔ سیستم را نمی‌توان از اینجا پیاده کرد."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "سامانهٔ پروندهٔ قابل نصبی وجود ندارد"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "پیاده کردن همهٔ سامانه‌های پرونده"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "نصب همهٔ سامانه‌های پرونده"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "پیاده کردن سامانهٔ پرونده"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "نصب سامانهٔ پرونده"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "در حال نصب سامانه‌های پرونده …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "در حال پیاده کردن سامانه‌های پرونده …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "عملیات سامانهٔ پرونده انجام شد"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "عملیات سامانهٔ پرونده ناموفق بود"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"عملیات زیر ناموفق بودند:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "%{size} در مجموع"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · میزان استفاده نامشخص است"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "نصب نشده · میزان استفاده در دسترس نیست"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "میزان استفاده نامشخص است · سامانهٔ پروندهٔ قابل اندازه‌گیری وجود ندارد"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} استفاده‌شده (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "حداقل %{size} استفاده‌شده (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} در دسترس"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} رزروشده"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} اندازه‌گیری شد"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"میزان استفاده نسبت به کل ظرفیت دیسک محاسبه می‌شود. سامانه‌های پروندهٔ نصب‌نشده "
"یا گسترده روی چند دستگاه در مجموع لحاظ نمی‌شوند. فضای افرازنشده فضای در دسترس "
"سامانهٔ پرونده نیست."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"افرازهای رزروشدهٔ مایکروسافت سامانهٔ پرونده ندارند و در مجموع استفاده لحاظ "
"نمی‌شوند."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "افراز رزروشده · بدون سامانهٔ پرونده"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "برای مشاهدهٔ استفاده از دیسک، این سامانهٔ پرونده را نصب کنید."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "اندازهٔ سامانهٔ پرونده: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "میزان استفاده در دسترس نیست"

#: src/window.cr:414
msgid "Not mounted"
msgstr "نصب نشده"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "استفاده‌شده توسط %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "فضای مبادله (فعال)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "رمزگذاری‌شده (قفل‌شده)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "رزروشدهٔ مایکروسافت (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "دادهٔ پایهٔ مایکروسافت"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "بازیابی ویندوز"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "افراز سامانهٔ EFI"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "سامانهٔ پرونده میزان استفاده از دیسک را گزارش نمی‌کند."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "خواندن سامانهٔ پرونده ممکن نشد."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 در دسترس نیست."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "سامانهٔ پرونده دیگر در دسترس نیست."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "این سامانهٔ پرونده را نمی‌توان از اینجا نصب یا پیاده کرد."
