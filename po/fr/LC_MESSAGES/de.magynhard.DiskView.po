#: src/window.cr:21 src/window.cr:28
msgid "Refresh"
msgstr "Actualiser"

#: src/window.cr:26
msgid "Main menu"
msgstr "Menu principal"

#: src/window.cr:29
msgid "About Disk View"
msgstr "À propos de Disk View"

#: src/window.cr:30 src/window.cr:218
msgid "Close"
msgstr "Fermer"

#: src/window.cr:40
msgid "Drives & Partitions"
msgstr "Disques et partitions"

#: src/window.cr:41
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Espace utilisé · actualisation automatique toutes les 15 secondes"

#: src/window.cr:104
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Disques, partitions et utilisation de l’espace disque en un coup d’œil.\n"
"Développé avec Crystal, GTK4 et libadwaita."

#: src/window.cr:132
msgid "Other filesystems / Network"
msgstr "Autres systèmes de fichiers / Réseau"

#: src/window.cr:140
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} disque"
msgstr[1] "%{count} disques"

#: src/window.cr:140
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Actualisé à %{time}"

#: src/window.cr:142
msgid "Could not read drives: %{error}"
msgstr "Impossible de lire les disques : %{error}"

#: src/window.cr:172
msgid "Reading …"
msgstr "Lecture…"

#: src/window.cr:189
msgid "System filesystems cannot be unmounted here."
msgstr "Les systèmes de fichiers système ne peuvent pas être démontés ici."

#: src/window.cr:191
msgid "No mountable filesystem"
msgstr "Aucun système de fichiers montable"

#: src/window.cr:193
msgid "Unmount all filesystems"
msgstr "Démonter tous les systèmes de fichiers"

#: src/window.cr:193
msgid "Mount all filesystems"
msgstr "Monter tous les systèmes de fichiers"

#: src/window.cr:195
msgid "Unmount filesystem"
msgstr "Démonter le système de fichiers"

#: src/window.cr:195
msgid "Mount filesystem"
msgstr "Monter le système de fichiers"

#: src/window.cr:209
msgid "Mounting filesystems …"
msgstr "Montage des systèmes de fichiers…"

#: src/window.cr:209
msgid "Unmounting filesystems …"
msgstr "Démontage des systèmes de fichiers…"

#: src/window.cr:215
msgid "Filesystem operation completed"
msgstr "Opération sur les systèmes de fichiers terminée"

#: src/window.cr:217
msgid "Filesystem operation failed"
msgstr "Échec de l’opération sur les systèmes de fichiers"

#: src/window.cr:217
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Les opérations suivantes ont échoué :\n"
"%{errors}"

#: src/window.cr:268 src/window.cr:306 src/window.cr:341
msgid "%{size} total"
msgstr "%{size} au total"

#: src/window.cr:269 src/window.cr:330
msgid "%{state} · Usage unknown"
msgstr "%{state} · Utilisation inconnue"

#: src/window.cr:292
msgid "Not mounted · usage unavailable"
msgstr "Non monté · utilisation indisponible"

#: src/window.cr:294
msgid "Usage unknown · no measurable filesystems"
msgstr "Utilisation inconnue · aucun système de fichiers mesurable"

#: src/window.cr:298 src/window.cr:339
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} utilisés (%{percent} %%)"

#: src/window.cr:300
msgid "At least %{size} used (%{percent} %%)"
msgstr "Au moins %{size} utilisés (%{percent} %%)"

#: src/window.cr:302 src/window.cr:340
msgid "%{size} available"
msgstr "%{size} disponibles"

#: src/window.cr:303 src/window.cr:342
msgid "%{size} reserved"
msgstr "%{size} réservés"

#: src/window.cr:304
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} mesurés"

#: src/window.cr:308
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"L’utilisation est relative à la capacité totale du disque. Les systèmes de "
"fichiers non montés ou répartis sur plusieurs périphériques sont exclus du "
"total. L’espace non partitionné n’est pas de l’espace disponible dans un "
"système de fichiers."

#: src/window.cr:309
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Les partitions réservées Microsoft n’ont pas de système de fichiers et sont "
"exclues de l’utilisation totale."

#: src/window.cr:328
msgid "Reserved partition · no filesystem"
msgstr "Partition réservée · aucun système de fichiers"

#: src/window.cr:332
msgid "Mount this filesystem to read its disk usage."
msgstr ""
"Montez ce système de fichiers pour connaître son utilisation de l’espace "
"disque."

#: src/window.cr:343
msgid "%{size} filesystem size"
msgstr "%{size} pour le système de fichiers"

#: src/window.cr:347
msgid "Usage unavailable"
msgstr "Utilisation indisponible"

#: src/window.cr:357
msgid "Not mounted"
msgstr "Non monté"

#: src/window.cr:359
msgid "Used by %{devices}"
msgstr "Utilisé par %{devices}"

#: src/window.cr:361
msgid "Swap (active)"
msgstr "Swap (actif)"

#: src/window.cr:363
msgid "Encrypted (locked)"
msgstr "Chiffré (verrouillé)"

#: src/window.cr:370
msgid "Microsoft reserved (MSR)"
msgstr "Réservée Microsoft (MSR)"

#: src/window.cr:371
msgid "Microsoft basic data"
msgstr "Données de base Microsoft"

#: src/window.cr:372
msgid "Windows recovery"
msgstr "Récupération Windows"

#: src/window.cr:373
msgid "EFI system partition"
msgstr "Partition système EFI"

#: src/window.cr:386
msgid "The filesystem does not report disk usage."
msgstr ""
"Le système de fichiers ne fournit pas son utilisation de l’espace disque."

#: src/window.cr:399
msgid "Could not read filesystem."
msgstr "Impossible de lire le système de fichiers."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 n’est pas disponible."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Le système de fichiers n’est plus disponible."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Ce système de fichiers ne peut pas être monté ou démonté ici."
