#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Atsvaidzināt"

#: src/window.cr:31
msgid "Main menu"
msgstr "Galvenā izvēlne"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Par Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Aizvērt"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Diski un nodalījumi"

#: src/window.cr:52
msgid "Size units"
msgstr "Izmēra mērvienības"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibaiti (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabaiti (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Izmantotā vieta · automātiski atjaunina ik pēc 15 sekundēm"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Disku, nodalījumu un vietas lietojuma pārskats.\n"
"Izveidots ar Crystal, GTK4 un libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Citas datņu sistēmas / Tīkls"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} disks"
msgstr[1] "%{count} diski"
msgstr[2] "%{count} disku"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Atjaunināts %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Neizdevās nolasīt diskus: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Nolasa …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Sistēmas datņu sistēmas šeit nevar atmontēt."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Nav montējamas datņu sistēmas"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Atmontēt visas datņu sistēmas"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Montēt visas datņu sistēmas"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Atmontēt datņu sistēmu"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Montēt datņu sistēmu"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Montē datņu sistēmas …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Atmontē datņu sistēmas …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Darbība ar datņu sistēmu pabeigta"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Darbība ar datņu sistēmu neizdevās"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Šīs darbības neizdevās:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "Kopā %{size}"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Lietojums nav zināms"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Nav montēta · lietojums nav pieejams"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Lietojums nav zināms · nav izmērāmu datņu sistēmu"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "Izmantoti %{size} (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Izmantoti vismaz %{size} (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "Pieejami %{size}"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "Rezervēti %{size}"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "Izmērīti %{known}/%{total}"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Lietojums tiek rādīts attiecībā pret visu diska ietilpību. Nemontētas un "
"vairākās ierīcēs izvietotas datņu sistēmas kopējā apjomā nav iekļautas. "
"Nesadalīta vieta nav pieejama datņu sistēmas vieta."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Microsoft rezervētajiem nodalījumiem nav datņu sistēmas, un tie nav iekļauti "
"kopējā lietojumā."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Rezervēts nodalījums · nav datņu sistēmas"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Montējiet šo datņu sistēmu, lai apskatītu diska lietojumu."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Datņu sistēmas izmērs: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Lietojums nav pieejams"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Nav montēta"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Izmanto %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Maiņvieta (aktīva)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Šifrēts (bloķēts)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Microsoft rezervēts (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Microsoft pamatdati"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Windows atkopšana"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "EFI sistēmas nodalījums"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Datņu sistēma nesniedz informāciju par diska lietojumu."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Neizdevās nolasīt datņu sistēmu."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 nav pieejams."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Datņu sistēma vairs nav pieejama."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Šo datņu sistēmu šeit nevar montēt vai atmontēt."
