#: src/window.cr:21 src/window.cr:28
msgid "Refresh"
msgstr "更新"

#: src/window.cr:26
msgid "Main menu"
msgstr "メインメニュー"

#: src/window.cr:29
msgid "About Disk View"
msgstr "Disk View について"

#: src/window.cr:30 src/window.cr:218
msgid "Close"
msgstr "閉じる"

#: src/window.cr:40
msgid "Drives & Partitions"
msgstr "ドライブとパーティション"

#: src/window.cr:41
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "使用済み領域 · 15秒ごとに自動更新"

#: src/window.cr:104
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"ドライブ、パーティション、ディスク使用量をひと目で確認できます。\n"
"Crystal、GTK4、libadwaita で開発されています。"

#: src/window.cr:132
msgid "Other filesystems / Network"
msgstr "その他のファイルシステム / ネットワーク"

#: src/window.cr:140
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} 台のドライブ"

#: src/window.cr:140
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · 更新時刻 %{time}"

#: src/window.cr:142
msgid "Could not read drives: %{error}"
msgstr "ドライブを読み取れませんでした：%{error}"

#: src/window.cr:172
msgid "Reading …"
msgstr "読み取り中…"

#: src/window.cr:189
msgid "System filesystems cannot be unmounted here."
msgstr "システムのファイルシステムはここではマウント解除できません。"

#: src/window.cr:191
msgid "No mountable filesystem"
msgstr "マウント可能なファイルシステムがありません"

#: src/window.cr:193
msgid "Unmount all filesystems"
msgstr "すべてのファイルシステムをマウント解除"

#: src/window.cr:193
msgid "Mount all filesystems"
msgstr "すべてのファイルシステムをマウント"

#: src/window.cr:195
msgid "Unmount filesystem"
msgstr "ファイルシステムをマウント解除"

#: src/window.cr:195
msgid "Mount filesystem"
msgstr "ファイルシステムをマウント"

#: src/window.cr:209
msgid "Mounting filesystems …"
msgstr "ファイルシステムをマウント中…"

#: src/window.cr:209
msgid "Unmounting filesystems …"
msgstr "ファイルシステムをマウント解除中…"

#: src/window.cr:215
msgid "Filesystem operation completed"
msgstr "ファイルシステムの操作が完了しました"

#: src/window.cr:217
msgid "Filesystem operation failed"
msgstr "ファイルシステムの操作に失敗しました"

#: src/window.cr:217
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"次の操作に失敗しました：\n"
"%{errors}"

#: src/window.cr:268 src/window.cr:306 src/window.cr:341
msgid "%{size} total"
msgstr "合計 %{size}"

#: src/window.cr:269 src/window.cr:330
msgid "%{state} · Usage unknown"
msgstr "%{state} · 使用量不明"

#: src/window.cr:292
msgid "Not mounted · usage unavailable"
msgstr "未マウント · 使用量を取得できません"

#: src/window.cr:294
msgid "Usage unknown · no measurable filesystems"
msgstr "使用量不明 · 測定可能なファイルシステムがありません"

#: src/window.cr:298 src/window.cr:339
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} 使用中（%{percent} %%）"

#: src/window.cr:300
msgid "At least %{size} used (%{percent} %%)"
msgstr "少なくとも %{size} 使用中（%{percent} %%）"

#: src/window.cr:302 src/window.cr:340
msgid "%{size} available"
msgstr "%{size} 利用可能"

#: src/window.cr:303 src/window.cr:342
msgid "%{size} reserved"
msgstr "%{size} 予約済み"

#: src/window.cr:304
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} 測定済み"

#: src/window.cr:308
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"使用率はドライブの全容量を基準としています。マウントされていないファイルシス"
"テムや複数のデバイスにまたがるファイルシステムは合計に含まれません。未割り当"
"て領域はファイルシステムの利用可能領域ではありません。"

#: src/window.cr:309
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Microsoft 予約パーティションにはファイルシステムがないため、合計使用量から除"
"外されます。"

#: src/window.cr:328
msgid "Reserved partition · no filesystem"
msgstr "予約パーティション · ファイルシステムなし"

#: src/window.cr:332
msgid "Mount this filesystem to read its disk usage."
msgstr ""
"ディスク使用量を確認するには、このファイルシステムをマウントしてください。"

#: src/window.cr:343
msgid "%{size} filesystem size"
msgstr "ファイルシステムのサイズ %{size}"

#: src/window.cr:347
msgid "Usage unavailable"
msgstr "使用量を取得できません"

#: src/window.cr:357
msgid "Not mounted"
msgstr "未マウント"

#: src/window.cr:359
msgid "Used by %{devices}"
msgstr "%{devices} が使用中"

#: src/window.cr:361
msgid "Swap (active)"
msgstr "スワップ（有効）"

#: src/window.cr:363
msgid "Encrypted (locked)"
msgstr "暗号化済み（ロック中）"

#: src/window.cr:370
msgid "Microsoft reserved (MSR)"
msgstr "Microsoft 予約（MSR）"

#: src/window.cr:371
msgid "Microsoft basic data"
msgstr "Microsoft 基本データ"

#: src/window.cr:372
msgid "Windows recovery"
msgstr "Windows 回復"

#: src/window.cr:373
msgid "EFI system partition"
msgstr "EFI システムパーティション"

#: src/window.cr:386
msgid "The filesystem does not report disk usage."
msgstr "このファイルシステムはディスク使用量を報告しません。"

#: src/window.cr:399
msgid "Could not read filesystem."
msgstr "ファイルシステムを読み取れませんでした。"

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 は利用できません。"

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "このファイルシステムは利用できなくなりました。"

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "このファイルシステムはここではマウントまたはマウント解除できません。"
