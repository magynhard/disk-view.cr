#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Atnaujinti"

#: src/window.cr:31
msgid "Main menu"
msgstr "Pagrindinis meniu"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Apie „Disk View“"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Užverti"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Diskai ir skaidiniai"

#: src/window.cr:52
msgid "Size units"
msgstr "Dydžio vienetai"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibaitai (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabaitai (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Naudojama vieta · automatiškai atnaujinama kas 15 sekundžių"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Diskų, skaidinių ir vietos naudojimo apžvalga.\n"
"Sukurta naudojant „Crystal“, GTK4 ir „libadwaita“."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Kitos failų sistemos / tinklas"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} diskas"
msgstr[1] "%{count} diskai"
msgstr[2] "%{count} diskų"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Atnaujinta %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Nepavyko nuskaityti diskų: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Nuskaitoma …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Sistemos failų sistemų čia atjungti negalima."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Nėra prijungiamos failų sistemos"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Atjungti visas failų sistemas"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Prijungti visas failų sistemas"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Atjungti failų sistemą"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Prijungti failų sistemą"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Prijungiamos failų sistemos …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Atjungiamos failų sistemos …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Failų sistemos veiksmas baigtas"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Failų sistemos veiksmas nepavyko"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Šie veiksmai nepavyko:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "Iš viso %{size}"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Naudojimas nežinomas"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Neprijungta · naudojimo duomenų nėra"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Naudojimas nežinomas · nėra išmatuojamų failų sistemų"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "Naudojama %{size} (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Naudojama bent %{size} (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "Laisva %{size}"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "Rezervuota %{size}"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "Išmatuota %{known}/%{total}"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Naudojimas nurodomas pagal visą disko talpą. Neprijungtos ir keliuose "
"įrenginiuose esančios failų sistemos į bendrą sumą neįtraukiamos. Neskaidyta "
"vieta nėra laisva failų sistemos vieta."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"„Microsoft“ rezervuoti skaidiniai neturi failų sistemos ir neįtraukiami į "
"bendrą naudojimą."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Rezervuotas skaidinys · nėra failų sistemos"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Prijunkite šią failų sistemą, kad pamatytumėte jos vietos naudojimą."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Failų sistemos dydis: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Naudojimo duomenų nėra"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Neprijungta"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Naudoja %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Mainų sritis (aktyvi)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Užšifruota (užrakinta)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "„Microsoft“ rezervuota (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "„Microsoft“ pagrindiniai duomenys"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "„Windows“ atkūrimas"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "EFI sistemos skaidinys"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Failų sistema nepateikia disko naudojimo duomenų."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Nepavyko nuskaityti failų sistemos."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 neprieinamas."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Failų sistema nebepasiekiama."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Šios failų sistemos čia negalima prijungti ar atjungti."
