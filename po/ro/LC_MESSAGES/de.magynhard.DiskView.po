#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Actualizează"

#: src/window.cr:31
msgid "Main menu"
msgstr "Meniu principal"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Despre Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Închide"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Unități și partiții"

#: src/window.cr:52
msgid "Size units"
msgstr "Unități de măsură"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibaiți (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabaiți (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Spațiu utilizat · se actualizează automat la fiecare 15 secunde"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Unitățile, partițiile și utilizarea discului dintr-o privire.\n"
"Creat cu Crystal, GTK4 și libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Alte sisteme de fișiere / Rețea"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} unitate"
msgstr[1] "%{count} unități"
msgstr[2] "%{count} de unități"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Actualizat la %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Unitățile nu au putut fi citite: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Se citește …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Sistemele de fișiere ale sistemului nu pot fi demontate aici."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Niciun sistem de fișiere care poate fi montat"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Demontează toate sistemele de fișiere"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Montează toate sistemele de fișiere"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Demontează sistemul de fișiere"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Montează sistemul de fișiere"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Se montează sistemele de fișiere …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Se demontează sistemele de fișiere …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Operațiunea asupra sistemului de fișiere s-a încheiat"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Operațiunea asupra sistemului de fișiere a eșuat"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Următoarele operațiuni au eșuat:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "%{size} în total"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Utilizare necunoscută"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Nemontat · utilizarea nu este disponibilă"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Utilizare necunoscută · nu există sisteme de fișiere măsurabile"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} utilizați (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Cel puțin %{size} utilizați (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} disponibili"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} rezervați"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} măsurați"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Utilizarea este raportată la capacitatea totală a unității. Sistemele de "
"fișiere nemontate sau aflate pe mai multe dispozitive sunt excluse din "
"total. Spațiul nepartiționat nu reprezintă spațiu disponibil într-un sistem "
"de fișiere."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Partițiile rezervate de Microsoft nu au sistem de fișiere și sunt excluse "
"din totalurile de utilizare."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Partiție rezervată · fără sistem de fișiere"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Montați acest sistem de fișiere pentru a vedea utilizarea discului."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Dimensiunea sistemului de fișiere: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Utilizarea nu este disponibilă"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Nemontat"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Utilizat de %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Spațiu de interschimb (activ)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Criptat (blocat)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Rezervat de Microsoft (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Date de bază Microsoft"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Recuperare Windows"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "Partiție de sistem EFI"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Sistemul de fișiere nu raportează utilizarea discului."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Sistemul de fișiere nu a putut fi citit."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 nu este disponibil."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Sistemul de fișiere nu mai este disponibil."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Acest sistem de fișiere nu poate fi montat sau demontat aici."
