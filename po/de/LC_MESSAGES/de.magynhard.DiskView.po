#: src/window.cr:17 src/window.cr:24
msgid "Refresh"
msgstr "Aktualisieren"

#: src/window.cr:22
msgid "Main menu"
msgstr "Hauptmenü"

#: src/window.cr:25
msgid "About Disk View"
msgstr "Über Disk View"

#: src/window.cr:26
msgid "Close"
msgstr "Schließen"

#: src/window.cr:36
msgid "Drives & Partitions"
msgstr "Laufwerke & Partitionen"

#: src/window.cr:37
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Belegter Speicher · automatische Aktualisierung alle 15 Sekunden"

#: src/window.cr:97
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Laufwerke, Partitionen und Speicherbelegung auf einen Blick.\n"
"Entwickelt mit Crystal, GTK4 und libadwaita."

#: src/window.cr:123
msgid "Other filesystems / Network"
msgstr "Weitere Dateisysteme / Netzwerk"

#: src/window.cr:131
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} Laufwerk"
msgstr[1] "%{count} Laufwerke"

#: src/window.cr:131
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Stand %{time}"

#: src/window.cr:133
msgid "Could not read drives: %{error}"
msgstr "Laufwerke konnten nicht gelesen werden: %{error}"

#: src/window.cr:163
msgid "Reading …"
msgstr "Wird gelesen …"

#: src/window.cr:204 src/window.cr:238 src/window.cr:261
msgid "%{size} total"
msgstr "%{size} gesamt"

#: src/window.cr:205 src/window.cr:252
msgid "%{state} · Usage unknown"
msgstr "%{state} · Belegung unbekannt"

#: src/window.cr:227
msgid "Usage unknown · no measurable filesystems"
msgstr "Belegung unbekannt · keine auswertbaren Dateisysteme"

#: src/window.cr:230 src/window.cr:259
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} belegt (%{percent} %%)"

#: src/window.cr:232
msgid "At least %{size} used (%{percent} %%)"
msgstr "Mindestens %{size} belegt (%{percent} %%)"

#: src/window.cr:234 src/window.cr:260
msgid "%{size} available"
msgstr "%{size} verfügbar"

#: src/window.cr:235 src/window.cr:262
msgid "%{size} reserved"
msgstr "%{size} reserviert"

#: src/window.cr:236
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} erfasst"

#: src/window.cr:240
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Belegung bezogen auf die gesamte Laufwerkskapazität. Nicht eingehängte oder "
"geräteübergreifende Dateisysteme sind nicht in der Summe enthalten. "
"Unpartitionierter Speicher ist kein verfügbarer Dateisystemspeicher."

#: src/window.cr:263
msgid "%{size} filesystem size"
msgstr "%{size} Dateisystemgröße"

#: src/window.cr:267
msgid "Usage unavailable"
msgstr "Belegung nicht verfügbar"

#: src/window.cr:277
msgid "Not mounted"
msgstr "Nicht eingehängt"

#: src/window.cr:279
msgid "Used by %{devices}"
msgstr "Verwendet von %{devices}"

#: src/window.cr:281
msgid "Swap (active)"
msgstr "Swap (aktiv)"

#: src/window.cr:294
msgid "The filesystem does not report disk usage."
msgstr "Das Dateisystem meldet keine Speicherbelegung."

#: src/window.cr:307
msgid "Could not read filesystem."
msgstr "Dateisystem konnte nicht gelesen werden."
