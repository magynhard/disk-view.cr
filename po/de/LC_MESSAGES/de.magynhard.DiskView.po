#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Aktualisieren"

#: src/window.cr:31
msgid "Main menu"
msgstr "Hauptmenü"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Über Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Schließen"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Laufwerke & Partitionen"

#: src/window.cr:52
msgid "Size units"
msgstr "Größeneinheiten"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibyte (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabyte (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Belegter Speicher · automatische Aktualisierung alle 15 Sekunden"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Laufwerke, Partitionen und Speicherbelegung auf einen Blick.\n"
"Entwickelt mit Crystal, GTK4 und libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Weitere Dateisysteme / Netzwerk"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} Laufwerk"
msgstr[1] "%{count} Laufwerke"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Stand %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Laufwerke konnten nicht gelesen werden: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Wird gelesen …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Systemdateisysteme können hier nicht ausgehängt werden."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Kein einhängbares Dateisystem"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Alle Dateisysteme aushängen"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Alle Dateisysteme einhängen"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Dateisystem aushängen"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Dateisystem einhängen"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Dateisysteme werden eingehängt …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Dateisysteme werden ausgehängt …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Dateisystemaktion abgeschlossen"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Dateisystemaktion fehlgeschlagen"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Folgende Aktionen sind fehlgeschlagen:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "%{size} gesamt"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Belegung unbekannt"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Nicht eingehängt · Belegung nicht verfügbar"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Belegung unbekannt · keine auswertbaren Dateisysteme"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} belegt (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Mindestens %{size} belegt (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} verfügbar"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} reserviert"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} erfasst"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Belegung bezogen auf die gesamte Laufwerkskapazität. Nicht eingehängte oder "
"geräteübergreifende Dateisysteme sind nicht in der Summe enthalten. "
"Unpartitionierter Speicher ist kein verfügbarer Dateisystemspeicher."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Microsoft-reservierte Partitionen haben kein Dateisystem und werden nicht in "
"die Gesamtbelegung eingerechnet."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Reservierte Partition · kein Dateisystem"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Hänge dieses Dateisystem ein, um seine Speicherbelegung auszulesen."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "%{size} Dateisystemgröße"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Belegung nicht verfügbar"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Nicht eingehängt"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Verwendet von %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Swap (aktiv)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Verschlüsselt (gesperrt)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Microsoft-reserviert (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Microsoft-Datenpartition"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Windows-Wiederherstellung"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "EFI-Systempartition"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Das Dateisystem meldet keine Speicherbelegung."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Dateisystem konnte nicht gelesen werden."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 ist nicht verfügbar."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Das Dateisystem ist nicht mehr verfügbar."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Dieses Dateisystem kann hier nicht ein- oder ausgehängt werden."
