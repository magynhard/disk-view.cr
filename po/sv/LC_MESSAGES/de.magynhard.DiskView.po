#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Uppdatera"

#: src/window.cr:31
msgid "Main menu"
msgstr "Huvudmeny"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Om Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Stäng"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Enheter och partitioner"

#: src/window.cr:52
msgid "Size units"
msgstr "Storleksenheter"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibyte (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabyte (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Använt utrymme · uppdateras automatiskt var 15:e sekund"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Enheter, partitioner och diskanvändning i en överblick.\n"
"Byggd med Crystal, GTK4 och libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Andra filsystem / Nätverk"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} enhet"
msgstr[1] "%{count} enheter"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Uppdaterad %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Kunde inte läsa enheterna: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Läser …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Systemfilsystem kan inte avmonteras här."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Inget monterbart filsystem"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Avmontera alla filsystem"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Montera alla filsystem"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Avmontera filsystem"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Montera filsystem"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Monterar filsystem …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Avmonterar filsystem …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Filsystemåtgärden slutfördes"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Filsystemåtgärden misslyckades"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Följande åtgärder misslyckades:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "%{size} totalt"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Användning okänd"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Inte monterad · användning otillgänglig"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Användning okänd · inga mätbara filsystem"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} använt (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Minst %{size} använt (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} tillgängligt"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} reserverat"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} uppmätta"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Användningen anges i förhållande till enhetens fulla kapacitet. Omonterade "
"filsystem och filsystem över flera enheter ingår inte i summan. "
"Opartitionerat utrymme är inte tillgängligt filsystemsutrymme."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Microsoft-reserverade partitioner saknar filsystem och ingår inte i den "
"totala användningen."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Reserverad partition · inget filsystem"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Montera filsystemet för att läsa dess diskanvändning."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Filsystemets storlek: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Användning otillgänglig"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Inte monterad"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Används av %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Växlingsutrymme (aktivt)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Krypterad (låst)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Microsoft-reserverad (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Microsoft-basdata"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Windows-återställning"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "EFI-systempartition"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Filsystemet rapporterar inte diskanvändning."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Kunde inte läsa filsystemet."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 är inte tillgängligt."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Filsystemet är inte längre tillgängligt."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Filsystemet kan inte monteras eller avmonteras här."
