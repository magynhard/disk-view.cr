#: src/window.cr:17 src/window.cr:24
msgid "Refresh"
msgstr "Odśwież"

#: src/window.cr:22
msgid "Main menu"
msgstr "Menu główne"

#: src/window.cr:25
msgid "About Disk View"
msgstr "O programie Disk View"

#: src/window.cr:26
msgid "Close"
msgstr "Zamknij"

#: src/window.cr:36
msgid "Drives & Partitions"
msgstr "Dyski i partycje"

#: src/window.cr:37
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Zajęte miejsce · automatyczne odświeżanie co 15 sekund"

#: src/window.cr:97
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Dyski, partycje i zajętość miejsca w jednym widoku.\n"
"Opracowano przy użyciu Crystal, GTK4 i libadwaita."

#: src/window.cr:123
msgid "Other filesystems / Network"
msgstr "Inne systemy plików / Sieć"

#: src/window.cr:131
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} dysk"
msgstr[1] "%{count} dyski"
msgstr[2] "%{count} dysków"

#: src/window.cr:131
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Zaktualizowano o %{time}"

#: src/window.cr:133
msgid "Could not read drives: %{error}"
msgstr "Nie można odczytać dysków: %{error}"

#: src/window.cr:163
msgid "Reading …"
msgstr "Odczytywanie…"

#: src/window.cr:204 src/window.cr:238 src/window.cr:261
msgid "%{size} total"
msgstr "%{size} łącznie"

#: src/window.cr:205 src/window.cr:252
msgid "%{state} · Usage unknown"
msgstr "%{state} · Zajętość nieznana"

#: src/window.cr:227
msgid "Usage unknown · no measurable filesystems"
msgstr "Zajętość nieznana · brak systemów plików możliwych do zmierzenia"

#: src/window.cr:230 src/window.cr:259
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} zajęte (%{percent} %%)"

#: src/window.cr:232
msgid "At least %{size} used (%{percent} %%)"
msgstr "Co najmniej %{size} zajęte (%{percent} %%)"

#: src/window.cr:234 src/window.cr:260
msgid "%{size} available"
msgstr "%{size} dostępne"

#: src/window.cr:235 src/window.cr:262
msgid "%{size} reserved"
msgstr "%{size} zarezerwowane"

#: src/window.cr:236
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} zmierzono"

#: src/window.cr:240
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Zajętość jest podana względem pełnej pojemności dysku. Niezamontowane "
"systemy plików oraz systemy plików obejmujące wiele urządzeń są wyłączone z "
"sumy. Miejsce bez partycji nie jest dostępnym miejscem systemu plików."

#: src/window.cr:263
msgid "%{size} filesystem size"
msgstr "%{size} — rozmiar systemu plików"

#: src/window.cr:267
msgid "Usage unavailable"
msgstr "Zajętość niedostępna"

#: src/window.cr:277
msgid "Not mounted"
msgstr "Niezamontowany"

#: src/window.cr:279
msgid "Used by %{devices}"
msgstr "Używany przez %{devices}"

#: src/window.cr:281
msgid "Swap (active)"
msgstr "Pamięć wymiany (aktywna)"

#: src/window.cr:294
msgid "The filesystem does not report disk usage."
msgstr "System plików nie udostępnia informacji o zajętości miejsca."

#: src/window.cr:307
msgid "Could not read filesystem."
msgstr "Nie można odczytać systemu plików."
