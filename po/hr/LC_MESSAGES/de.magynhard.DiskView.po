#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Osvježi"

#: src/window.cr:31
msgid "Main menu"
msgstr "Glavni izbornik"

#: src/window.cr:34
msgid "About Disk View"
msgstr "O aplikaciji Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Zatvori"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Diskovi i particije"

#: src/window.cr:52
msgid "Size units"
msgstr "Jedinice veličine"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibajti (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabajti (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Iskorišteni prostor · automatsko osvježavanje svakih 15 sekundi"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Pregled diskova, particija i iskorištenosti prostora.\n"
"Izrađeno pomoću Crystala, GTK4 i libadwaite."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Ostali datotečni sustavi / Mreža"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} disk"
msgstr[1] "%{count} diska"
msgstr[2] "%{count} diskova"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Ažurirano u %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Nije moguće očitati diskove: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Učitavanje …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Sistemski datotečni sustavi ovdje se ne mogu odmontirati."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Nema datotečnog sustava koji se može montirati"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Odmontiraj sve datotečne sustave"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Montiraj sve datotečne sustave"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Odmontiraj datotečni sustav"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Montiraj datotečni sustav"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Montiranje datotečnih sustava …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Odmontiranje datotečnih sustava …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Radnja nad datotečnim sustavom dovršena je"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Radnja nad datotečnim sustavom nije uspjela"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Sljedeće radnje nisu uspjele:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "Ukupno %{size}"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Iskorištenost je nepoznata"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Nije montirano · podaci o iskorištenosti nisu dostupni"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Iskorištenost je nepoznata · nema mjerljivih datotečnih sustava"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "Iskorišteno %{size} (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Iskorišteno najmanje %{size} (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "Dostupno %{size}"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "Rezervirano %{size}"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "Izmjereno %{known}/%{total}"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Iskorištenost se prikazuje u odnosu na ukupni kapacitet diska. Nemontirani "
"datotečni sustavi i sustavi na više uređaja nisu uključeni u ukupni iznos. "
"Neparticionirani prostor nije dostupan prostor datotečnog sustava."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Microsoftove rezervirane particije nemaju datotečni sustav i nisu uključene "
"u ukupnu iskorištenost."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Rezervirana particija · nema datotečnog sustava"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Montirajte ovaj datotečni sustav za prikaz iskorištenosti prostora."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Veličina datotečnog sustava: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Podaci o iskorištenosti nisu dostupni"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Nije montirano"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Koristi %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Zamjenski prostor (aktivan)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Šifrirano (zaključano)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Microsoftova rezervirana particija (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Microsoftovi osnovni podaci"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Oporavak sustava Windows"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "EFI sistemska particija"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Datotečni sustav ne prijavljuje iskorištenost prostora."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Nije moguće očitati datotečni sustav."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 nije dostupan."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Datotečni sustav više nije dostupan."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Ovaj datotečni sustav ovdje nije moguće montirati ni odmontirati."
