#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Segarkan"

#: src/window.cr:31
msgid "Main menu"
msgstr "Menu utama"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Perihal Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Tutup"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Pemacu dan Sekatan"

#: src/window.cr:52
msgid "Size units"
msgstr "Unit saiz"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibait (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabait (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Ruang digunakan · disegar semula secara automatik setiap 15 saat"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Gambaran pemacu, sekatan dan penggunaan cakera.\n"
"Dibina dengan Crystal, GTK4 dan libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Sistem fail lain / Rangkaian"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} pemacu"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Dikemas kini %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Tidak dapat membaca pemacu: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Membaca …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Sistem fail sistem tidak boleh dinyahlekap di sini."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Tiada sistem fail yang boleh dilekap"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Nyahlekap semua sistem fail"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Lekapkan semua sistem fail"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Nyahlekap sistem fail"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Lekapkan sistem fail"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Melekapkan sistem fail …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Menyahlekap sistem fail …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Operasi sistem fail selesai"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Operasi sistem fail gagal"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Operasi berikut gagal:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "Jumlah %{size}"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Penggunaan tidak diketahui"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Tidak dilekap · penggunaan tidak tersedia"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Penggunaan tidak diketahui · tiada sistem fail yang boleh diukur"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} digunakan (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Sekurang-kurangnya %{size} digunakan (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} tersedia"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} dikhaskan"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} diukur"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Penggunaan dibandingkan dengan kapasiti penuh pemacu. Sistem fail yang tidak "
"dilekap atau merentasi beberapa peranti tidak termasuk dalam jumlah. Ruang "
"yang belum disekat bukan ruang sistem fail yang tersedia."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Sekatan yang dikhaskan Microsoft tidak mempunyai sistem fail dan tidak "
"termasuk dalam jumlah penggunaan."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Sekatan khas · tiada sistem fail"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Lekapkan sistem fail ini untuk melihat penggunaan cakeranya."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Saiz sistem fail: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Penggunaan tidak tersedia"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Tidak dilekap"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Digunakan oleh %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Ruang swap (aktif)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Disulitkan (terkunci)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Dikhaskan Microsoft (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Data asas Microsoft"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Pemulihan Windows"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "Sekatan sistem EFI"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Sistem fail tidak melaporkan penggunaan cakera."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Tidak dapat membaca sistem fail."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 tidak tersedia."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Sistem fail tidak lagi tersedia."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Sistem fail ini tidak boleh dilekap atau dinyahlekap di sini."
