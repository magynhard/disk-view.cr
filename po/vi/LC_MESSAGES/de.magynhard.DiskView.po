#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Làm mới"

#: src/window.cr:31
msgid "Main menu"
msgstr "Trình đơn chính"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Giới thiệu Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Đóng"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Ổ đĩa và phân vùng"

#: src/window.cr:52
msgid "Size units"
msgstr "Đơn vị dung lượng"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibyte (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabyte (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Dung lượng đã dùng · tự động làm mới sau mỗi 15 giây"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Tổng quan về ổ đĩa, phân vùng và mức sử dụng đĩa.\n"
"Được xây dựng bằng Crystal, GTK4 và libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Hệ thống tệp khác / Mạng"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} ổ đĩa"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Đã cập nhật lúc %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Không thể đọc ổ đĩa: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Đang đọc …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Không thể bỏ gắn kết hệ thống tệp của hệ thống tại đây."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Không có hệ thống tệp có thể gắn kết"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Bỏ gắn kết tất cả hệ thống tệp"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Gắn kết tất cả hệ thống tệp"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Bỏ gắn kết hệ thống tệp"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Gắn kết hệ thống tệp"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Đang gắn kết hệ thống tệp …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Đang bỏ gắn kết hệ thống tệp …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Đã hoàn tất thao tác với hệ thống tệp"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Thao tác với hệ thống tệp thất bại"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Các thao tác sau đã thất bại:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "Tổng cộng %{size}"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Không rõ mức sử dụng"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Chưa gắn kết · không có thông tin sử dụng"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Không rõ mức sử dụng · không có hệ thống tệp đo được"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "Đã dùng %{size} (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Đã dùng ít nhất %{size} (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "Còn trống %{size}"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "Đã dành riêng %{size}"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "Đã đo %{known}/%{total}"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Mức sử dụng được tính theo toàn bộ dung lượng ổ đĩa. Các hệ thống tệp chưa "
"gắn kết hoặc trải trên nhiều thiết bị không được tính vào tổng số. Dung "
"lượng chưa phân vùng không phải là dung lượng còn trống của hệ thống tệp."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Phân vùng dành riêng của Microsoft không có hệ thống tệp và không được tính "
"vào tổng mức sử dụng."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Phân vùng dành riêng · không có hệ thống tệp"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Gắn kết hệ thống tệp này để xem mức sử dụng đĩa."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Dung lượng hệ thống tệp: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Không có thông tin sử dụng"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Chưa gắn kết"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Được sử dụng bởi %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Vùng hoán đổi (đang hoạt động)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Đã mã hóa (đã khóa)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Dành riêng cho Microsoft (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Dữ liệu cơ bản Microsoft"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Khôi phục Windows"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "Phân vùng hệ thống EFI"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Hệ thống tệp không cung cấp thông tin sử dụng đĩa."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Không thể đọc hệ thống tệp."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 không khả dụng."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Hệ thống tệp không còn khả dụng."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Không thể gắn kết hoặc bỏ gắn kết hệ thống tệp này tại đây."
