#: src/window.cr:21 src/window.cr:28
msgid "Refresh"
msgstr "Обновить"

#: src/window.cr:26
msgid "Main menu"
msgstr "Главное меню"

#: src/window.cr:29
msgid "About Disk View"
msgstr "О приложении Disk View"

#: src/window.cr:30 src/window.cr:218
msgid "Close"
msgstr "Закрыть"

#: src/window.cr:40
msgid "Drives & Partitions"
msgstr "Накопители и разделы"

#: src/window.cr:41
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Занятое место · автоматическое обновление каждые 15 секунд"

#: src/window.cr:104
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Накопители, разделы и использование дискового пространства на одном экране.\n"
"Разработано с помощью Crystal, GTK4 и libadwaita."

#: src/window.cr:132
msgid "Other filesystems / Network"
msgstr "Другие файловые системы / Сеть"

#: src/window.cr:140
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} накопитель"
msgstr[1] "%{count} накопителя"
msgstr[2] "%{count} накопителей"

#: src/window.cr:140
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Обновлено в %{time}"

#: src/window.cr:142
msgid "Could not read drives: %{error}"
msgstr "Не удалось прочитать накопители: %{error}"

#: src/window.cr:172
msgid "Reading …"
msgstr "Чтение…"

#: src/window.cr:189
msgid "System filesystems cannot be unmounted here."
msgstr "Системные файловые системы нельзя размонтировать здесь."

#: src/window.cr:191
msgid "No mountable filesystem"
msgstr "Нет файловой системы для монтирования"

#: src/window.cr:193
msgid "Unmount all filesystems"
msgstr "Размонтировать все файловые системы"

#: src/window.cr:193
msgid "Mount all filesystems"
msgstr "Смонтировать все файловые системы"

#: src/window.cr:195
msgid "Unmount filesystem"
msgstr "Размонтировать файловую систему"

#: src/window.cr:195
msgid "Mount filesystem"
msgstr "Смонтировать файловую систему"

#: src/window.cr:209
msgid "Mounting filesystems …"
msgstr "Монтирование файловых систем…"

#: src/window.cr:209
msgid "Unmounting filesystems …"
msgstr "Размонтирование файловых систем…"

#: src/window.cr:215
msgid "Filesystem operation completed"
msgstr "Операция с файловыми системами завершена"

#: src/window.cr:217
msgid "Filesystem operation failed"
msgstr "Не удалось выполнить операцию с файловыми системами"

#: src/window.cr:217
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Не удалось выполнить следующие операции:\n"
"%{errors}"

#: src/window.cr:268 src/window.cr:306 src/window.cr:341
msgid "%{size} total"
msgstr "%{size} всего"

#: src/window.cr:269 src/window.cr:330
msgid "%{state} · Usage unknown"
msgstr "%{state} · Занятое место неизвестно"

#: src/window.cr:292
msgid "Not mounted · usage unavailable"
msgstr "Не смонтирован · данные об использовании недоступны"

#: src/window.cr:294
msgid "Usage unknown · no measurable filesystems"
msgstr "Занятое место неизвестно · нет файловых систем, доступных для оценки"

#: src/window.cr:298 src/window.cr:339
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} занято (%{percent} %%)"

#: src/window.cr:300
msgid "At least %{size} used (%{percent} %%)"
msgstr "Занято не менее %{size} (%{percent} %%)"

#: src/window.cr:302 src/window.cr:340
msgid "%{size} available"
msgstr "%{size} доступно"

#: src/window.cr:303 src/window.cr:342
msgid "%{size} reserved"
msgstr "%{size} зарезервировано"

#: src/window.cr:304
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} учтено"

#: src/window.cr:308
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Использование рассчитано относительно полной ёмкости накопителя. "
"Несмонтированные файловые системы и файловые системы на нескольких "
"устройствах не включены в итог. Неразмеченное пространство не является "
"доступным местом файловой системы."

#: src/window.cr:309
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Зарезервированные разделы Microsoft не имеют файловой системы и не "
"включаются в общее использование."

#: src/window.cr:328
msgid "Reserved partition · no filesystem"
msgstr "Зарезервированный раздел · нет файловой системы"

#: src/window.cr:332
msgid "Mount this filesystem to read its disk usage."
msgstr ""
"Смонтируйте эту файловую систему, чтобы узнать использование дискового "
"пространства."

#: src/window.cr:343
msgid "%{size} filesystem size"
msgstr "%{size} — размер файловой системы"

#: src/window.cr:347
msgid "Usage unavailable"
msgstr "Данные об использовании недоступны"

#: src/window.cr:357
msgid "Not mounted"
msgstr "Не смонтирован"

#: src/window.cr:359
msgid "Used by %{devices}"
msgstr "Используется %{devices}"

#: src/window.cr:361
msgid "Swap (active)"
msgstr "Подкачка (активна)"

#: src/window.cr:363
msgid "Encrypted (locked)"
msgstr "Зашифрован (заблокирован)"

#: src/window.cr:370
msgid "Microsoft reserved (MSR)"
msgstr "Зарезервированный Microsoft (MSR)"

#: src/window.cr:371
msgid "Microsoft basic data"
msgstr "Основные данные Microsoft"

#: src/window.cr:372
msgid "Windows recovery"
msgstr "Восстановление Windows"

#: src/window.cr:373
msgid "EFI system partition"
msgstr "Системный раздел EFI"

#: src/window.cr:386
msgid "The filesystem does not report disk usage."
msgstr "Файловая система не сообщает об использовании дискового пространства."

#: src/window.cr:399
msgid "Could not read filesystem."
msgstr "Не удалось прочитать файловую систему."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 недоступен."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Файловая система больше недоступна."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Эту файловую систему нельзя смонтировать или размонтировать здесь."
