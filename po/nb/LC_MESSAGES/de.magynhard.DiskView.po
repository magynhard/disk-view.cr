#: src/window.cr:26 src/window.cr:33
msgid "Refresh"
msgstr "Oppdater"

#: src/window.cr:31
msgid "Main menu"
msgstr "Hovedmeny"

#: src/window.cr:34
msgid "About Disk View"
msgstr "Om Disk View"

#: src/window.cr:35 src/window.cr:258
msgid "Close"
msgstr "Lukk"

#: src/window.cr:46
msgid "Drives & Partitions"
msgstr "Stasjoner og partisjoner"

#: src/window.cr:52
msgid "Size units"
msgstr "Størrelsesenheter"

#: src/window.cr:55
msgid "Gibibytes (GiB)"
msgstr "Gibibyte (GiB)"

#: src/window.cr:57
msgid "Gigabytes (GB)"
msgstr "Gigabyte (GB)"

#: src/window.cr:73
msgid "Used space · refreshes automatically every 15 seconds"
msgstr "Brukt plass · oppdateres automatisk hvert 15. sekund"

#: src/window.cr:133
msgid ""
"Drives, partitions and disk usage at a glance.\n"
"Built with Crystal, GTK4 and libadwaita."
msgstr ""
"Oversikt over stasjoner, partisjoner og diskbruk.\n"
"Laget med Crystal, GTK4 og libadwaita."

#: src/window.cr:162
msgid "Other filesystems / Network"
msgstr "Andre filsystemer / Nettverk"

#: src/window.cr:170
msgid "%{count} drive"
msgid_plural "%{count} drives"
msgstr[0] "%{count} stasjon"
msgstr[1] "%{count} stasjoner"

#: src/window.cr:170
msgid "%{drives} · Updated %{time}"
msgstr "%{drives} · Oppdatert %{time}"

#: src/window.cr:172
msgid "Could not read drives: %{error}"
msgstr "Kunne ikke lese stasjonene: %{error}"

#: src/window.cr:202
msgid "Reading …"
msgstr "Leser …"

#: src/window.cr:229
msgid "System filesystems cannot be unmounted here."
msgstr "Systemfilsystemer kan ikke avmonteres her."

#: src/window.cr:231
msgid "No mountable filesystem"
msgstr "Ingen filsystemer som kan monteres"

#: src/window.cr:233
msgid "Unmount all filesystems"
msgstr "Avmonter alle filsystemer"

#: src/window.cr:233
msgid "Mount all filesystems"
msgstr "Monter alle filsystemer"

#: src/window.cr:235
msgid "Unmount filesystem"
msgstr "Avmonter filsystem"

#: src/window.cr:235
msgid "Mount filesystem"
msgstr "Monter filsystem"

#: src/window.cr:249
msgid "Mounting filesystems …"
msgstr "Monterer filsystemer …"

#: src/window.cr:249
msgid "Unmounting filesystems …"
msgstr "Avmonterer filsystemer …"

#: src/window.cr:255
msgid "Filesystem operation completed"
msgstr "Filsystemhandlingen er fullført"

#: src/window.cr:257
msgid "Filesystem operation failed"
msgstr "Filsystemhandlingen mislyktes"

#: src/window.cr:257
msgid ""
"The following operations failed:\n"
"%{errors}"
msgstr ""
"Følgende handlinger mislyktes:\n"
"%{errors}"

#: src/window.cr:317 src/window.cr:358 src/window.cr:397
msgid "%{size} total"
msgstr "%{size} totalt"

#: src/window.cr:318 src/window.cr:384
msgid "%{state} · Usage unknown"
msgstr "%{state} · Bruk ukjent"

#: src/window.cr:344
msgid "Not mounted · usage unavailable"
msgstr "Ikke montert · bruksinformasjon er utilgjengelig"

#: src/window.cr:346
msgid "Usage unknown · no measurable filesystems"
msgstr "Bruk ukjent · ingen målbare filsystemer"

#: src/window.cr:350 src/window.cr:395
msgid "%{size} used (%{percent} %%)"
msgstr "%{size} brukt (%{percent} %%)"

#: src/window.cr:352
msgid "At least %{size} used (%{percent} %%)"
msgstr "Minst %{size} brukt (%{percent} %%)"

#: src/window.cr:354 src/window.cr:396
msgid "%{size} available"
msgstr "%{size} tilgjengelig"

#: src/window.cr:355 src/window.cr:398
msgid "%{size} reserved"
msgstr "%{size} reservert"

#: src/window.cr:356
msgid "%{known}/%{total} measured"
msgstr "%{known}/%{total} målt"

#: src/window.cr:360
msgid ""
"Usage is relative to the full drive capacity. Unmounted or multi-device "
"filesystems are excluded from the total. Unpartitioned space is not "
"available filesystem space."
msgstr ""
"Bruken vises i forhold til stasjonens totale kapasitet. Umonterte "
"filsystemer og filsystemer på flere enheter er ikke med i totalen. "
"Upartisjonert plass er ikke tilgjengelig plass på et filsystem."

#: src/window.cr:361
msgid ""
"Microsoft reserved partitions have no filesystem and are excluded from usage "
"totals."
msgstr ""
"Partisjoner reservert av Microsoft har ikke filsystem og er ikke med i den "
"totale bruken."

#: src/window.cr:382
msgid "Reserved partition · no filesystem"
msgstr "Reservert partisjon · intet filsystem"

#: src/window.cr:386
msgid "Mount this filesystem to read its disk usage."
msgstr "Monter dette filsystemet for å se diskbruken."

#: src/window.cr:399
msgid "%{size} filesystem size"
msgstr "Filsystemstørrelse: %{size}"

#: src/window.cr:404
msgid "Usage unavailable"
msgstr "Bruksinformasjon er utilgjengelig"

#: src/window.cr:414
msgid "Not mounted"
msgstr "Ikke montert"

#: src/window.cr:416
msgid "Used by %{devices}"
msgstr "Brukes av %{devices}"

#: src/window.cr:418
msgid "Swap (active)"
msgstr "Veksleminne (aktivt)"

#: src/window.cr:420
msgid "Encrypted (locked)"
msgstr "Kryptert (låst)"

#: src/window.cr:427
msgid "Microsoft reserved (MSR)"
msgstr "Reservert av Microsoft (MSR)"

#: src/window.cr:428
msgid "Microsoft basic data"
msgstr "Microsoft-grunndata"

#: src/window.cr:429
msgid "Windows recovery"
msgstr "Windows-gjenoppretting"

#: src/window.cr:430
msgid "EFI system partition"
msgstr "EFI-systempartisjon"

#: src/window.cr:443
msgid "The filesystem does not report disk usage."
msgstr "Filsystemet rapporterer ikke diskbruk."

#: src/window.cr:456
msgid "Could not read filesystem."
msgstr "Kunne ikke lese filsystemet."

#: src/mount_service.cr:32
msgid "UDisks2 is unavailable."
msgstr "UDisks2 er ikke tilgjengelig."

#: src/mount_service.cr:46
msgid "The filesystem is no longer available."
msgstr "Filsystemet er ikke lenger tilgjengelig."

#: src/mount_service.cr:84
msgid "This filesystem cannot be mounted or unmounted here."
msgstr "Dette filsystemet kan ikke monteres eller avmonteres her."
