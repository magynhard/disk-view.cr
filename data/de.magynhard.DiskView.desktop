[Desktop Entry]
Name=Disk View
Comment=View drives, partitions and disk usage
Comment[de]=Laufwerke, Partitionen und Speicherbelegung anzeigen
Exec=disk-view
Icon=de.magynhard.DiskView
Terminal=false
Type=Application
Categories=GTK;System;Filesystem;
Keywords=disk;drive;partition;storage;usage;
Keywords[de]=Laufwerk;Festplatte;Partition;Speicher;Belegung;
StartupNotify=true
